        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam packageStyle rectangle\nskinparam defaultFontName \&quot;Segoe UI\&quot;\n\nactor \&quot;Bệnh nhân\&quot; as Patient\nactor \&quot;Bác sĩ / NVYT\&quot; as Doctor\nactor \&quot;Hệ thống tự động\&quot; as System\n\nrectangle \&quot;Phân rã Use Case: Từ Theo Dõi Sinh Hiệu đến Xử Lý Cảnh Báo &amp; SOS\&quot; {\n  \n  &#39; Nhóm Sinh hiệu\n  usecase \&quot;Nhập chỉ số sinh hiệu\\n(SpO2, Huyết áp, Tim)\&quot; as UC_Vitals\n  usecase \&quot;Lưu nhật ký 30 ngày\&quot; as UC_SaveLog\n  usecase \&quot;Phân tích tự động ngưỡng\&quot; as UC_Analyze\n  \n  &#39; Nhóm Cảnh báo &amp; SOS\n  usecase \&quot;Kích hoạt khẩn cấp SOS\&quot; as UC_SOS\n  usecase \&quot;Đính kèm tọa độ GPS\&quot; as UC_GPS\n  usecase \&quot;Tiếp nhận cảnh báo đỏ\&quot; as UC_Alert\n  \n  &#39; Nhóm Telehealth &amp; Thuốc\n  usecase \&quot;Quản lý lịch uống thuốc\&quot; as UC_Med\n  usecase \&quot;Đặt lịch Telehealth\&quot; as UC_Booking\n  usecase \&quot;Thực hiện Video Call\&quot; as UC_Video\n  \n  usecase \&quot;Gửi thông báo đẩy (FCM)\&quot; as UC_FCM\n}\n\n&#39; Liên kết Actor với Use Case chính\nPatient --&gt; UC_Vitals\nPatient --&gt; UC_Med\nPatient --&gt; UC_SOS\nPatient --&gt; UC_Booking\nPatient --&gt; UC_Video\n\nDoctor --&gt; UC_Alert\nDoctor --&gt; UC_Video\n\nSystem --&gt; UC_Analyze\nSystem --&gt; UC_FCM\n\n&#39; Mối quan hệ phân rã (Include / Extend / Trigger)\nUC_Vitals ..&gt; UC_SaveLog : &lt;&lt;include&gt;&gt;\nUC_Vitals ..&gt; UC_Analyze : &lt;&lt;include&gt;&gt;\n\nUC_Analyze ..&gt; UC_Alert : &lt;&lt;extend&gt;&gt;\\n[Khi chỉ số vượt ngưỡng đỏ]\nUC_Analyze ..&gt; UC_FCM : &lt;&lt;extend&gt;&gt;\\n[Nhắc nhở / Cảnh báo]\n\nUC_SOS ..&gt; UC_GPS : &lt;&lt;include&gt;&gt;\nUC_SOS ..&gt; UC_Alert : &lt;&lt;trigger&gt;&gt;\\n[Báo động cấp cứu]\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z1y4xTPKS42X9qJm-FQP-1">
