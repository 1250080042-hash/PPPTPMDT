        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam defaultTextFontName Arial\n\nactor \&quot;Bệnh nhân\&quot; as Patient\nboundary \&quot;FrmLichUongThuoc\&quot; as Form\ncontrol \&quot;MedicineService\&quot; as Service\nentity \&quot;MedicineSchedule\&quot; as MedicineSchedule\n\nPatient -&gt; Form: Mở danh sách lịch uống thuốc hằng ngày\nForm -&gt; Service: LayLichUongThuoc(maBN, ngayHienTai)\nService -&gt; MedicineSchedule: Truy vấn thông tin phác đồ thuốc\nMedicineSchedule --&gt; Service: Trả về danh sách thuốc (Tên thuốc, liều lượng, khung giờ)\nService --&gt; Form: Hiển thị lịch cá nhân hóa theo buổi (Sáng, Trưa, Tối, Đêm)\n\nPatient -&gt; Form: Chọn loại thuốc và bấm xác nhận \&quot;Đã uống\&quot;\nForm -&gt; Service: confirmTaken(medID, thoiGianXacNhan)\n\nalt [quá thời gian TimeSlot cho phép]\n    Service --&gt; Form: KetQuaXuLy.Fail(\&quot;Đã hết giờ / Bỏ lỡ lịch uống thuốc\&quot;)\nelse [hợp lệ - trong thời gian quy định]\n    Service -&gt; MedicineSchedule: Cập nhật trạng thái IsTaken = True\n    Service --&gt; Form: KetQuaXuLy.Ok(\&quot;Đã xác nhận uống thuốc thành công\&quot;)\nend\n\nForm --&gt; Patient: Hiển thị thông báo và cập nhật giao diện\n@enduml\n&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z1y4xTPKS42X9qJm-FQP-1">
