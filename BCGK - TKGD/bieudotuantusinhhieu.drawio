        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam style strictuml\nskinparam defaultTextFontName Arial\n\nactor \&quot;Bệnh nhân\&quot; as Patient\nboundary \&quot;FrmSOS\&quot; as Form\ncontrol \&quot;SOSService\&quot; as Service\nentity \&quot;SOSAlert\&quot; as SOSAlert\nboundary \&quot;NotificationService\&quot; as FCM\nentity \&quot;MedicalRecord\&quot; as MedicalRecord\nactor \&quot;Bác sĩ / NVYTE\&quot; as Doctor\n\nPatient -&gt; Form: Bấm nút khẩn cấp \&quot;SOS\&quot;\nForm -&gt; Service: triggerSOS(maBN, gpsCoordinates)\n\nalt [dữ liệu định vị không hợp lệ / lỗi kết nối]\n    Service --&gt; Form: KetQuaXuLy.Fail(lý do)\nelse [hợp lệ - trong 1 transaction an toàn]\n    Service -&gt; SOSAlert: sendSOS(sosID, latitude, longitude, timestamp, status)\n    SOSAlert -&gt; MedicalRecord: Lấy thông tin hồ sơ và bác sĩ phụ trách\n    MedicalRecord --&gt; SOSAlert: Thông tin liên hệ bệnh nhân &amp; bác sĩ\n    \n    group Gửi thông báo ưu tiên cao\n        SOSAlert --&gt; FCM: Gửi thông báo đẩy (FCM) khẩn cấp\n        FCM -&gt; Doctor: Hiển thị cảnh báo đỏ ưu tiên cao nhất + Tọa độ GPS\n    end\n    \n    Service --&gt; Form: KetQuaXuLy.Ok(trangThai: \&quot;Đang xử lý / Hỗ trợ y tế\&quot;)\nend\n\nForm --&gt; Patient: Hiển thị thông báo xác nhận: \&quot;Đã gửi tín hiệu cứu hộ khẩn cấp!\&quot;\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z1y4xTPKS42X9qJm-FQP-1">
