        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Segoe UI\&quot;\nskinparam defaultFontSize 12\n\nskinparam packageStyle rectangle\nskinparam rectangle {\n  BackgroundColor #FEF9C3\n  BorderColor #9F1239\n  BorderThickness 1.5\n  FontColor #451A03\n}\n\nskinparam usecase {\n  BackgroundColor #FEF9C3\n  BorderColor #9F1239\n  FontColor #451A03\n  BorderThickness 1.5\n}\n\nleft to right direction\n\nactor \&quot;Benh nhan\&quot; as Patient\nactor \&quot;Bac si / NVYT\&quot; as Doctor\nactor \&quot;He thong tu dong\&quot; as System\n\nrectangle \&quot;Quy trinh: Theo doi sinh hieu -&gt; Xu ly SOS &amp; Telehealth\&quot; {\n  \n  usecase \&quot;Nhap chi so sinh hieu\\n(SpO2, Huyet ap, Tim)\&quot; as UC1\n  usecase \&quot;Luu nhat ky 30 ngay\&quot; as UC1_Inc1\n  usecase \&quot;Kiem tra nguoi y te chuan\&quot; as UC1_Inc2\n  \n  usecase \&quot;Kich hoa khan cap SOS\&quot; as UC2\n  usecase \&quot;Dinh kem toa do GPS\&quot; as UC2_Inc\n  \n  usecase \&quot;Dat lich tu van Telehealth\&quot; as UC3\n  usecase \&quot;Thuc hien Video Call\&quot; as UC3_Ext\n  \n  usecase \&quot;Phan tich tu dong\&quot; as UC4\n  usecase \&quot;Gui canh bao do\&quot; as UC4_Ext1\n  usecase \&quot;Gui thong bao FCM\&quot; as UC4_Ext2\n\n  &#39; Lien ket Actor\n  Patient --&gt; UC1\n  Patient --&gt; UC2\n  Patient --&gt; UC3\n  \n  Doctor --&gt; UC3_Ext\n  Doctor --&gt; UC4_Ext1\n  \n  System --&gt; UC4\n\n  &#39; Quan he Include / Extend\n  UC1 ..&gt; UC1_Inc1 : &lt;&lt;include&gt;&gt;\n  UC1 ..&gt; UC1_Inc2 : &lt;&lt;include&gt;&gt;\n  \n  UC2 ..&gt; UC2_Inc : &lt;&lt;include&gt;&gt;\n  UC2 ..&gt; UC4_Ext1 : &lt;&lt;trigger&gt;&gt;\n  \n  UC3 ..&gt; UC3_Ext : &lt;&lt;extend&gt;&gt;\\n[den gio hen]\n  \n  UC4 ..&gt; UC4_Ext1 : &lt;&lt;extend&gt;&gt;\\n[vuot nguong do]\n  UC4 ..&gt; UC4_Ext2 : &lt;&lt;extend&gt;&gt;\\n[nhac nho uong thuoc]\n}\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z1y4xTPKS42X9qJm-FQP-1">
