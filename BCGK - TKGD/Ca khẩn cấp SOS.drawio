        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Segoe UI\&quot;\nskinparam defaultFontSize 11\n\nskinparam state {\n  BackgroundColor #FEF9C3\n  BorderColor #9F1239\n  FontColor #451A03\n  BorderThickness 1.5\n}\n\nleft to right direction\n\nstate \&quot;Đã đặt lịch\&quot; as DaDatLich {\n  entry/ lưu thông tin lịch hẹn, bác sĩ,\\nchọn khung giờ tư vấn\n}\n\nstate \&quot;Đã xác nhận\&quot; as DaXacNhan {\n  entry/ bác sĩ chấp thuận lịch khám\n}\n\nstate \&quot;Đang diễn ra\&quot; as DangDienRa {\n  do/ thực hiện video call khám trực tuyến\n}\n\nstate \&quot;Hoàn thành\&quot; as HoanThanh {\n  entry/ cập nhật kết quả và toa thuốc\n}\n\nstate \&quot;Đã hủy\&quot; as DaHuy {\n  entry/ ghi nhận hủy lịch hẹn\n}\n\n[*] --&gt; DaDatLich : BookAppointment()\\n[chọn bác sĩ, giờ trống]\n\nDaDatLich --&gt; DaXacNhan : XacNhanLich()\nDaXacNhan --&gt; DangDienRa : when(AppointmentDate)\nDangDienRa --&gt; HoanThanh : KetThucTuVan()\n\nDaDatLich --&gt; DaHuy : HuyLich()\\n[trước giờ hẹn]\n\nnote bottom of DaDatLich\n  Trạng thái lưu trong CSDL: Đã đặt lịch,\n  Đã xác nhận, Đang diễn ra,\n  Hoàn thành, Đã hủy.\nend note\n\nDaHuy --&gt; [*]\nHoanThanh --&gt; [*]\n\n@enduml&quot;,&#xa;  &quot;config&quot;: null&#xa;}" id="z1y4xTPKS42X9qJm-FQP-1">
