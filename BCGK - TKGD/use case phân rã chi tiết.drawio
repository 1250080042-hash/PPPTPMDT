        <UserObject label="" plantUmlData="{&#xa;  &quot;data&quot;: &quot;@startuml\nskinparam defaultFontName \&quot;Segoe UI\&quot;\nskinparam defaultFontSize 11\nskinparam classAttributeIconSize 0\n\nskinparam class {\n  BackgroundColor #FEF9C3\n  BorderColor #9F1239\n  FontColor #451A03\n  BorderThickness 1.5\n}\n\nleft to right direction\n\nclass Patient {\n  + PatientID : String\n  + FullName : String\n  + Phone : String\n  + Address : String\n  + DateOfBirth : Date\n  + login()\n  + inputVitals()\n  + triggerSOS()\n}\n\nclass Doctor {\n  + DoctorID : String\n  + FullName : String\n  + Specialization : String\n  + Phone : String\n  + receiveAlert()\n  + reviewVitals()\n}\n\nclass MedicalRecord {\n  + RecordID : String\n  + Diagnosis : String\n  + Notes : String\n  + createRecord()\n}\n\nclass VitalsLog {\n  + LogID : String\n  + SpO2 : Decimal\n  + BloodPressure : Decimal\n  + HeartRate : Integer\n  + Status : String\n  + Timestamp : DateTime\n  + processThreshold()\n}\n\nclass MedicineSchedule {\n  + MedID : String\n  + MedName : String\n  + Dosage : String\n  + TimeSlot : String\n  + IsTaken : Boolean\n  + confirmTaken()\n}\n\nclass SOSAlert {\n  + SOSID : String\n  + Latitude : Double\n  + Longitude : Double\n  + AlertTime : DateTime\n  + Status : String\n  + sendSOS()\n}\n\nclass TelehealthAppointment {\n  + AppointmentID : String\n  + AppointmentDate : DateTime\n  + Status : String\n  + bookAppointment()\n  + executeVideoCall()\n}\n\n&#39; Thiết lập mạng lưới liên kết lưới giống mẫu\nPatient \&quot;1\&quot; *-- \&quot;1\&quot; MedicalRecord : sở hữu &gt;\nPatient \&quot;1\&quot; *-- \&quot;0..*\&quot; VitalsLog : ghi nhận &gt;\nPatient \&quot;1\&quot; *-- \&quot;0..*\&quot; MedicineSchedule : có &gt;\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; SOSAlert : kích hoạt &gt;\nPatient \&quot;1\&quot; -- \&quot;0..*\&quot; TelehealthAppointment : đặt lịch &gt;\nDoctor \&quot;1\&quot; -- \&quot;0..*\&quot; TelehealthAppointment : tham gia &gt;\nDoctor \&quot;1